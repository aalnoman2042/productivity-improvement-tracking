# Random secret used to sign login cookies (use a long random string)
SESSION_SECRET=generate-a-long-random-string

# Friends need this code to create an account — share it only with them
INVITE_CODE=choose-something-private

# MongoDB connection string
# Local dev:   mongodb://localhost:27017
# Production:  mongodb+srv://user:password@cluster.xxxxx.mongodb.net (Atlas)
MONGODB_URI=mongodb://localhost:27017

# Database name (optional, defaults to "pit")
# MONGODB_DB=pit

# --- Password reset emails (optional) --------------------------------------
# Without one of these, /forgot tells people to ask the owner for a reset.

# Easiest, and needs no domain: send through your own Gmail.
# Turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-app-password

# Or use Resend — but it only delivers to strangers once you've verified a
# domain you own at resend.com/domains.
# RESEND_API_KEY=re_...

# Sender shown on the email (optional)
# MAIL_FROM=PIT <you@gmail.com>

# --- Nightly reminder notifications (optional) ------------------------------
# Without these, the Account page says reminders aren't set up and nothing
# else changes.
#
# Run `npm run vapid-keys` once and paste the output here. Regenerating the
# keys later unsubscribes every device, so generate them once and keep them.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact address push services can reach you at if a push misbehaves.
# VAPID_SUBJECT=mailto:you@example.com

# Secret the nightly job must present to run. Vercel Cron sends this
# automatically as a Bearer token once it's set as an environment variable.
# CRON_SECRET=

# Address used in password-reset emails. Unset, the app works it out from the
# request — set it only if reset links ever point at the wrong host.
# APP_URL=https://your-app.vercel.app

# --- The health page (optional) --------------------------------------------
# /health is with invited members while it is being tested, because it reads
# what your trackers *mean* through the same shared free-tier AI allowance the
# coach runs on (GROQ_API_KEY / GEMINI_API_KEY — see lib/ai.ts). Set this to
# open it to every account with no deploy, the way ADMIN_EMAILS works.
# The older CORTISOL_OPEN is still honoured, since that is what is set today.
# HEALTH_OPEN=1

# Skip the per-boot validator/index sync once the database is known to be in
# shape — shaves round trips off cold starts.
# PIT_SKIP_SCHEMA_SYNC=1
